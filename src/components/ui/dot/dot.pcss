.dot-wrapper {
    position: relative;
    width: 10px;
    height: 10px;
    margin-right: 10px;
}

.dot {
    position: absolute;
    inset: 0;
    background: var(--color-bg-secondary);
    border-radius: 9999px;
}

.dot.success { background: var(--color-bg-success); }
.dot.warning { background: var(--color-bg-warning); }
.dot.error { background: var(--color-bg-error); }

.dot::after {
    content: "";
    position: absolute;
    inset: 0;
    background: inherit;
    border-radius: inherit;
    animation: dot-animation 1s infinite ease-out;
}

@keyframes dot-animation {
    0% {
        transform: scale(0.2);
        opacity: 1;
    }
    100% {
        transform: scale(2.1);
        opacity: 0;
    }
}

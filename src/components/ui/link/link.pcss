.link {
    opacity: 0.75;
    transition:
        opacity 0.3s ease-in-out,
        box-shadow 0.3s ease-in-out;

    &:hover {
        opacity: 1;

        .link-dollar {
        }
    }

    .link-dollar {
        margin-right: 10px;
        color: var(--color-bg-secondary);
    }

    .link-text {
        position: relative;
        display: inline-block;

        /*  opacity-75 select-none cursor-pointer hover:opacity-100 transition-opacity duration-300 ease-in-out uppercase w-fit */
        user-select: none;
        cursor: pointer;
    }

    .link-text::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 2px;
        bottom: -3px;
        left: 0;
        background-color: var(--color-bg-secondary);

        transform: scaleX(0);
        transform-origin: bottom left;
        transition: transform 0.3s ease-in-out;
    }
    .link-text:hover::after {
        transform: scaleX(1);
    }

}

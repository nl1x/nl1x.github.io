.link {
    position: relative;
    display: inline-block;

    /*  opacity-75 select-none cursor-pointer hover:opacity-100 transition-opacity duration-300 ease-in-out uppercase w-fit */
    opacity: 0.75;
    user-select: none;
    cursor: pointer;
    transition: opacity 0.3s ease-in-out;

    &:hover {
        opacity: 1;
    }
}

.link::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 2px;
    bottom: -2px;
    left: 0;
    background-color: var(--color-bg-secondary);

    transform: scaleX(0);
    transform-origin: bottom left;
    transition: transform 0.3s ease-in-out;
}
.link:hover::after {
    transform: scaleX(1);
}
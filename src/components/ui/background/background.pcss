#background {
    position: fixed;
    width: 100%;
    height: 100svh;

    top: 0;
    left: 0;

    z-index: -10;
    pointer-events: none;

    background: radial-gradient(
            circle at 50% calc(var(--topbar-height) + var(--background-start)),
            var(--color-bg-secondary) 0%,
            var(--color-bg-primary) 70%
    );
}

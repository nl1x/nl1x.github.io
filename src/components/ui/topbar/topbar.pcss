.topbar {
    position: sticky;
    top: 0;
    left: 0;

    border-bottom: solid 1px white;
    width: 100%;
    height: 75px;
    background: var(--color-bg-primary);

    display: grid;
    grid-template-columns: repeat(3, 1fr);

    > div {
        overflow: hidden;
        width: 100%;
        height: 100%;

        display: flex;
        align-items: center;
    }

    .topbar-left {
        padding-left: 30px;
        text-align: left;
        justify-content: left;
    }

    .topbar-center {
        text-align: center;
        justify-content: center;
    }

    .topbar-right {
        margin-right: 30px;
        text-align: right;
        justify-content: right;
    }
}

